{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["capacitor.config.ts", "vite.config.ts", "vite.rivals.config.ts", "vite.rivals3d.config.ts", "playwright.rivals.config.ts", "playwright.rivals3d.config.ts", "vitest.config.ts", "tailwind.config.ts"]
}
