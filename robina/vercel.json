      "permanent": false
    },
    {
      "source": "/assets/rugfire/environment/cargo_crate.glb",
      "destination": "/assets/rugfire/environment/cargo_crate.glb.gz",
      "permanent": false
    },
    {
      "source": "/assets/rugfire/props/health_kit.glb",
      "destination": "/assets/rugfire/props/health_kit.glb.gz",
      "permanent": false
    }
  ]
}
