        {
          "key": "Content-Type",
          "value": "model/gltf-binary"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    { "source": "/gaming", "destination": "/", "permanent": false },
    { "source": "/tasks", "destination": "/", "permanent": false },
    { "source": "/leaderboard", "destination": "/leaderboards", "permanent": false },
    { "source": "/auto-claim", "destination": "/", "permanent": false },
    { "source": "/marketplace", "destination": "/", "permanent": false },
    { "source": "/login", "destination": "/", "permanent": false },
    {
      "source": "/assets/rivals/characters/universal-operative.glb",
      "destination": "/assets/rivals/characters/universal-operative.glb.gz",
      "permanent": false
    },
    {
      "source": "/assets/rivals/city/living-city.glb",
      "destination": "/assets/rivals/city/living-city.glb.gz",
      "permanent": false
    },
    {
      "source": "/assets/rivals/city/optimized/city-blocks.glb",
      "destination": "/assets/rivals/city/optimized/city-blocks.glb.gz",
      "permanent": false
    },
    {
      "source": "/assets/rivals/city/optimized/street-car.glb",
      "destination": "/assets/rivals/city/optimized/street-car.glb.gz",
