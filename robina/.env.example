# ==========================================================
# ROBINA FRONTEND ENV TEMPLATE
# ==========================================================
# Copy this file to .env for local development or deployment.
# IMPORTANT: do not expose secrets in the frontend; only public IDs belong here.
# ==========================================================

# Backend API base URL
# Local example: http://localhost:4000
# Production example: https://your-backend.example.com
VITE_API_URL=http://localhost:4000

# Optional override for Robinhood RPC used by wallet UI if needed.
# Get from your provider or use official public RPC fallback.
# VITE_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional Base RPC override. Public fallback is https://mainnet.base.org.
# VITE_BASE_RPC_URL=https://mainnet.base.org
# Solana mainnet RPC for Phantom USDC payments. Use a dedicated provider for production.
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Privy public app ID
# Get it from: https://dashboard.privy.io/ -> your app -> App settings
VITE_PRIVY_APP_ID=

# Reown AppKit project ID
# Get it from: https://cloud.reown.com/ -> Project settings -> Project ID
VITE_REOWN_PROJECT_ID=

# Optional Reown wallet registry IDs to feature in the modal.
# Leave blank unless you have the exact wallet IDs from Reown's wallet list.
VITE_REOWN_FEATURED_WALLET_IDS=
