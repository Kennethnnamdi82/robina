# ======================================
# BaseDrop Frontend Environment Template
# ======================================
# Copy to: robina/.env

# Backend API base URL.
# Local example:
VITE_API_URL=http://localhost:4000

# Render example:
# VITE_API_URL=https://basedrop-backend.onrender.com

# Robinhood Chain mainnet RPC (optional; the official public RPC is the fallback).
# Robinhood recommends a dedicated RPC provider for production traffic.
# VITE_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
