{
  "name": "basedrop-backend",
  "version": "1.0.0",
  "description": "BaseDrop Web3 mining backend (Express + MongoDB + viem) for Base Mainnet (8453)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test",
    "smoke": "node scripts/smoke-check.mjs",
    "migrate:task-expiry": "node scripts/migrate-task-expiry.mjs",
    "migrate:task-expiry:apply": "node scripts/migrate-task-expiry.mjs --apply",
    "verify:wallet": "node scripts/real-wallet-signoff.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "siwe": "^2.3.2",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^2.0.18"
  },
  "overrides": {
    "braces": "^3.0.3",
    "cross-spawn": "^7.0.5",
    "got": "^11.8.6"
  }
}