# RIVALS backend — Render environment template (NO real credentials).
# Render > your backend service > Environment > Add from .env.
# Replace placeholders BEFORE saving. Preserve existing production credentials.
# Do not upload this unchanged; never commit your real .env or share its values.
# Render service: root directory backend; build npm ci --omit=dev; start npm start.

# Production security/validation. Required on Render.
NODE_ENV=production

# Render's Node runtime version. Compatible with this backend and release CI.
NODE_VERSION=24

# Render sets PORT automatically; normally do not add/override it there.
# PORT=10000

# Existing MongoDB Atlas URI and database name. Must support transactions
# (replica set or sharded cluster). Do NOT switch databases or create a new URI.
MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER/EXISTING_DATABASE

# Signs player/admin sessions and protects security state. Keep your EXISTING
# strong value (at least 32 characters); replacing it signs existing users out.
JWT_SECRET=REPLACE_WITH_YOUR_EXISTING_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Website host used for wallet sign-in: no https://, path or trailing slash.
SIWE_DOMAIN=rivals-heist.vercel.app

# Same website's exact HTTPS origin: no path or trailing slash.
SIWE_URI=https://rivals-heist.vercel.app

# Allowed browser origins, comma-separated, no trailing slashes. Include SIWE_URI.
# Keep any other EXISTING trusted production origins; do not use *.
CORS_ORIGIN=https://rivals-heist.vercel.app

# Enforces HTTPS-only authentication cookies. Must be true in production.
COOKIE_SECURE=true

# Cross-site cookie support for the separately hosted Render API. Secure required.
# The first-party Vercel relay independently uses Secure, HttpOnly, SameSite=Lax.
COOKIE_SAMESITE=none

# Optional cookie domain. Normally OMIT on Render (host-only cookie).
# Do not set the Vercel hostname as the Render service's cookie domain.
# If already configured for your own working custom domain, preserve that value.
# COOKIE_DOMAIN=.your-existing-custom-domain.example

# EXISTING wallet-login challenge chain (Robinhood 4663), NOT the bounty chain.
# Do not change to 8453: Base bounty payouts are fixed separately in backend code.
CHAIN_ID=4663

# Existing Privy app's PUBLIC ID; must match frontend VITE_PRIVY_APP_ID.
PRIVY_APP_ID=REPLACE_WITH_YOUR_EXISTING_PRIVY_APP_ID

# Existing Privy app's SERVER SECRET for verifying Google/Privy authentication.
# Backend only. Never use a VITE_ prefix or send this value to the frontend.
PRIVY_APP_SECRET=REPLACE_WITH_YOUR_EXISTING_PRIVY_APP_SECRET

# Existing owner email for /admin/login and the standalone /admin/bounties page.
ADMIN_EMAIL=REPLACE_WITH_YOUR_EXISTING_OWNER_EMAIL

# Existing bcrypt password HASH, not your plain-text password. Keep the full
# existing hash, including every $ character. Do not regenerate it unnecessarily.
ADMIN_PASSWORD_HASH='REPLACE_WITH_YOUR_EXISTING_BCRYPT_HASH'

# ---- Bounties and manual withdrawals ----
# NO new environment variables or treasury credentials are required.
# The owner reviews each submission and enters the amount to credit in admin.
# The owner pays from their OWN Base wallet, then clicks Mark Paid in admin.
# The backend records that confirmation, settles the reservation and notifies
# the player to check their wallet. It does NOT send or verify the payment.
# Never enter your wallet's seed phrase/private key into this application.
# Old BOUNTY_PAYOUTS_ENABLED/private-key/treasury/gas-limit settings are unused
# by the production payment flow, even if they remain in your Render environment.
# Only for recovery of a PRE-EXISTING signed payment, an optional HTTPS Base RPC
# can be provided for READ-ONLY receipt checks. It cannot sign or send money.
# BOUNTY_BASE_RPC_URL=https://YOUR_TRUSTED_BASE_MAINNET_RPC
# Do not discard recovery records for unresolved old transactions or pay them
# manually; reconcile the existing transaction to avoid double-paying.
# The minimum withdrawal remains 5 USDC. All payment destinations use Base.
# Frontend VITE_API_URL/VITE_PRIVY_APP_ID/VITE_REOWN_PROJECT_ID belong in Vercel
# and Android CI, not here. NEVER copy private secrets into VITE_*.
